{
  "action": {
    "default_icon": {
      "16": "img/icon.png",
      "48": "img/icon.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "description": "Convert any webpage to Markdown format with a single click",
  "icons": {
    "128": "img/icon.png",
    "16": "img/icon.png",
    "48": "img/icon.png"
  },
  "manifest_version": 3,
  "name": "Webpage to Markdown",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "downloads.ui",
    "webNavigation",
    "sidePanel",
    "offscreen",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "convert-page": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Convert active tab to Markdown"
    }
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "options_page": "settings.html",
  "version": "1.8.0"
}
