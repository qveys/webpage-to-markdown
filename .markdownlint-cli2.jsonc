{
  "config": {
    "MD013": false,
    "MD024": false,
    "MD029": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    ".paperclip",
    ".remember",
    ".claude",
    ".cursor",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/superpowers/**/*.md",
    // Mirrors lint.yml's paths-ignore: these dirs hold only .html/.png today,
    // but keeping local `npm run lint:md` and CI in sync avoids a silent
    // divergence the day a .md file lands in one of them.
    "beta",
    "privacy",
    "support",
    "img",
    "docs/screenshots"
  ]
}
