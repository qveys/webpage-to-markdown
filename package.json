{
  "name": "webpage-to-markdown",
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "test": "node --require ./tests/setup/chrome-mock.js --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc.json .stylelintrc.json .markdownlint-cli2.jsonc .github/workflows/lint.yml",
    "lint": "eslint js/ tests/",
    "lint:css": "stylelint \"styles.css\"",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:all": "npm run format:check && npm run lint && npm run lint:css && npm run lint:md"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
