{
  "name": "webpage-to-markdown",
  "version": "1.1.0",
  "description": "A Chrome extension that converts any webpage to Markdown format with a single click.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,html,css,json}'",
    "format:check": "prettier --check 'src/**/*.{js,html,css,json}'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.4"
  }
}
